{:paths ["src"]
 ;; Zero third-party runtime deps. Request/wire namespaces are portable .cljc;
 ;; the embedded GGUF reader is JVM-specific.
 ;; A vLLM inference request IS data (:vllm/* maps); the library renders it to the
 ;; OpenAI/vLLM wire shape (string-keyed maps) and normalizes responses. The actual
 ;; HTTP + JSON (de)serialization is a host-injected ITransport port.
 :deps {
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/json {:git/sha "15fd195ac41e6268e2005ccbf6cb9924e81e65e2"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  :real-gguf-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms128m" "-Xmx512m"]
   :main-opts ["-m" "vllm.real-gguf-verify"]}
  :metal-worker-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms64m" "-Xmx256m"]
   :main-opts ["-m" "vllm.metal-worker-verify"]}
  :real-metal-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms128m" "-Xmx512m"]
   :main-opts ["-m" "vllm.real-metal-verify"]}
  :real-batch-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms128m" "-Xmx512m"]
   :main-opts ["-m" "vllm.real-batch-verify"]}
  :real-continuous-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms128m" "-Xmx512m"]
   :main-opts ["-m" "vllm.real-continuous-verify"]}
  :real-prefix-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms128m" "-Xmx512m"]
   :main-opts ["-m" "vllm.real-prefix-verify"]}}}
